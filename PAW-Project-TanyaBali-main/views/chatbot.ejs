<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/style.css"></head><body><header class="site-header"><a class="brand" href="/"><img src="/logo.png" alt=""><span>Tanya<span class="brand-accent">Bali</span></span></a><nav class="main-nav"><a href="/">Beranda</a><a href="/referensi">Tentang</a></nav><div class="header-actions"><span class="user-greeting">Hai, <%= currentUser.name.split(' ')[0] %></span><form action="/logout" method="POST"><button class="btn btn-outline">Keluar</button></form></div></header><main class="chat-page"><section class="chat-shell"><header class="chat-top"><div><h1>TanyaBali Assistant</h1><p>Asisten informasi wisata, pura, dan kuliner Bali</p></div><span class="chat-status">● Online</span></header><div class="chat-messages" id="messages" aria-live="polite"><div class="message bot">Halo, <%= currentUser.name.split(' ')[0] %>! 👋 Saya TanyaBali. Mau mencari informasi wisata, pura, atau kuliner khas Bali?</div></div><div class="chat-suggestions"><button class="suggestion">Di mana lokasi Pura Tanah Lot?</button><button class="suggestion">Kuliner khas Klungkung apa saja?</button><button class="suggestion">Wisata populer di Badung?</button></div><form class="chat-compose" id="chatForm"><input id="messageInput" maxlength="1000" placeholder="Tulis pertanyaan tentang Bali..." autocomplete="off" required><button type="submit" aria-label="Kirim">↑</button></form></section></main><script src="/js/chatbot.js"></script></body></html>
